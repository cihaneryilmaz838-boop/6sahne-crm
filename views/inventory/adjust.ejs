<%- include('../_header', { title }) %>

<h1>Adjust Stock</h1>

<p class="muted">Adjust updates stock up/down at a single location for corrections.</p>
<p><a href="/inventory">← Inventory overview</a> | <a href="/inventory/move">Move</a> | <a href="/inventory/adjust">Adjust</a></p>

<% if (errors && errors.length) { %>
  <div class="errors">
    <strong>Validation errors:</strong>
    <ul>
      <% errors.forEach((err) => { %><li><%= err %></li><% }) %>
    </ul>
  </div>
<% } %>

<form method="post" action="/inventory/adjust">
  <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
  <p>
    <label>Book
      <select name="book_id" required>
        <option value="">Select</option>
        <% books.forEach((book) => { %>
          <option value="<%= book.id %>" <%= String(form.book_id) === String(book.id) ? 'selected' : '' %>>
            <%= book.title %>
          </option>
        <% }) %>
      </select>
    </label>
  </p>
  <p>
    <label>Location
      <select name="location_id" required>
        <option value="">Select</option>
        <% locations.forEach((location) => { %>
          <option value="<%= location.id %>" <%= String(form.location_id) === String(location.id) ? 'selected' : '' %>><%= location.name %></option>
        <% }) %>
      </select>
    </label>
  </p>
  <p>
    <label>Direction
      <select name="direction" required>
        <option value="IN" <%= String(form.direction).toUpperCase() === 'IN' ? 'selected' : '' %>>IN (Increase)</option>
        <option value="OUT" <%= String(form.direction).toUpperCase() === 'OUT' ? 'selected' : '' %>>OUT (Decrease)</option>
      </select>
    </label>
  </p>
  <p>
    <label>Quantity <input type="number" min="1" step="1" name="quantity" value="<%= form.quantity %>" required></label>
  </p>
  <p>
    <label>Note <input type="text" name="note" value="<%= form.note %>" minlength="3" maxlength="255" required></label>
  </p>
  <button type="submit">Save Adjustment</button>
</form>

<p><a href="/inventory">Back to inventory</a></p>

<%- include('../_footer') %>
