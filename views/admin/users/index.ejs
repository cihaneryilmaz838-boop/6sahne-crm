<%- include('../../_header', { title }) %>

<h1>Users</h1>
<p>
  <a href="/admin/users/new">Create New User</a>
</p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Username</th>
      <th>Role</th>
      <th>Status</th>
      <th>Created At</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach((user) => { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.username %></td>
        <td><%= user.role %></td>
        <td>
          <% if (user.is_active) { %>
            <span class="status-badge status-active">ACTIVE</span>
          <% } else { %>
            <span class="status-badge status-cancelled">INACTIVE</span>
          <% } %>
        </td>
        <td><%= user.created_at %></td>
        <td><a href="/admin/users/<%= user.id %>">Manage</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../../_footer') %>
