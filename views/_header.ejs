<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    nav { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    nav a { margin-right: 0; }
    .cancelled { color: #9b1c1c; font-weight: bold; }
    .errors { background: #fee; border: 1px solid #f99; padding: 10px; margin: 10px 0; }
    .success { background: #efe; border: 1px solid #7c7; padding: 10px; margin: 10px 0; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; vertical-align: top; }
    form.inline { display: inline; }
    .muted { color: #666; font-size: 0.9em; }
    .spacer { flex: 1; }
  </style>
</head>
<body>
  <nav>
    <% if (currentUser) { %>
      <a href="/">Home</a>
      <a href="/students">Students</a>
      <a href="/books">Books</a>
      <a href="/inventory">Inventory</a>
      <a href="/finance">Finance</a>
      <a href="/sales/new">Sales</a>
      <a href="/reports">Reports</a>
      <a href="/account/password">Change Password</a>
      <span class="spacer"></span>
      <span class="muted">User: <%= currentUser.username %> (<%= currentUser.role %>)</span>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <button type="submit">Logout</button>
      </form>
    <% } else { %>
      <a href="/login">Login</a>
    <% } %>
  </nav>
  <hr>
